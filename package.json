{
  "name": "@marianmeres/cron",
  "version": "4.0.0",
  "description": "PostgreSQL-backed recurring cron job scheduler: concurrent workers (FOR UPDATE SKIP LOCKED), drift-safe scheduling, lease tokens with heartbeat, retries with capped backoff, timeouts with AbortSignal, IANA timezones, tenant scoping and a task registry.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "API.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/cron.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/cron/issues"
  },
  "homepage": "https://github.com/marianmeres/cron#readme",
  "keywords": [
    "cron",
    "scheduler",
    "postgres",
    "postgresql",
    "job",
    "jobs",
    "recurring",
    "worker",
    "retry",
    "backoff",
    "timezone",
    "multi-tenant"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env \"tests/**/*.test.ts\"",
    "test:watch": "node --test --test-concurrency=1 --watch --env-file-if-exists=.env \"tests/**/*.test.ts\"",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.3.0",
    "rp": "pnpm run release -y && pnpm publish",
    "rpm": "pnpm run release minor -y && pnpm publish"
  },
  "dependencies": {
    "@marianmeres/clog": "^3.23.1",
    "@marianmeres/cron-parser": "^1.0.1",
    "@marianmeres/modelize": "^3.0.0",
    "@marianmeres/parse-boolean": "^2.2.0",
    "@marianmeres/pubsub": "^3.1.0",
    "@marianmeres/sqlkit": "^0.3.2"
  },
  "peerDependencies": {
    "ajv": "^8.20.0"
  },
  "peerDependenciesMeta": {
    "ajv": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
